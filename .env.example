# Supabase env vars — set automatically by Vercel-Supabase integration
# Run: npx vercel env pull .env.local

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used only by scripts/setup-supabase.js to create the first admin user.
# Pick your own email and a long password. Do not commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
